    "pino-http": "^10.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.0"
  }
