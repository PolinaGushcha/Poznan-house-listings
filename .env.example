# Copy to .env for local development. Never commit real values.
# Production and staging values live in AWS SSM Parameter Store under /phl/<environment>/ (see infra/README.md).

# --- Shared ---
APP_ENV=development
LOG_LEVEL=debug

# --- API (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://phl:phl-local-password@localhost:5432/phl_dev
# Comma-separated origins allowed to call the API directly (empty = same-origin only)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Old Town reference point (Old Market Square) used for distances
OLD_TOWN_LAT=52.4083
OLD_TOWN_LON=16.9339

# --- Web (apps/web) ---
# Where the Next.js server reaches the API (server-side requests and the /api rewrite in development)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
